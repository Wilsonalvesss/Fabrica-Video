# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Canal
NICHO=inteligência artificial na prática
DURACAO_ALVO_MIN=8

# Roteiro: usa sua assinatura do Claude pelo comando `claude` (Claude Code).
# Só preencha ANTHROPIC_API_KEY se um dia quiser usar a API paga no lugar.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Voz: ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
# O VOICE_ID aparece na biblioteca de vozes, no botão "ID" da voz escolhida.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NOME=Narrador

# Cenas: Pexels (grátis em https://www.pexels.com/api/)
PEXELS_API_KEY=

# YouTube: horários de publicação (separados por vírgula) e fuso
HORARIOS=18:00
FUSO=America/Sao_Paulo

# true = publica sozinho, sem passar pela aba Revisão
AUTO_PUBLICAR=false
