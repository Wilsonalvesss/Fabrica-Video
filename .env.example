# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Canal
NICHO=inteligência artificial na prática
DURACAO_ALVO_MIN=8

# Roteiro com a API do Claude (opcional: sem ela, o Claude Code escreve o roteiro)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Voz: edge (grátis) ou elevenlabs
VOZ_PROVEDOR=edge
EDGE_VOZ=pt-BR-AntonioNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Cenas do banco de imagens Pexels (grátis em https://www.pexels.com/api/)
PEXELS_API_KEY=

# YouTube: horários de publicação (separados por vírgula) e fuso
HORARIOS=18:00
FUSO=America/Sao_Paulo
