# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Canal
NICHO=inteligência artificial na prática
# short = YouTube Short vertical; longo = vídeo 16:9 com shorts dos melhores trechos
FORMATO=short
DURACAO_SHORT_S=30
DURACAO_ALVO_MIN=8

# Roteiro: usa sua assinatura do Claude pelo comando `claude` (Claude Code).
# Só preencha ANTHROPIC_API_KEY se um dia quiser usar a API paga no lugar.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Voz: ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
# O VOICE_ID aparece na biblioteca de vozes, no botão "ID" da voz escolhida.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NOME=Narrador

# Cenas: Pixabay (grátis em https://pixabay.com/api/docs/, a chave aparece logado na seção "Parameters")
PIXABAY_API_KEY=
# Ou Pexels, se você já tiver uma chave (tem prioridade quando preenchida)
PEXELS_API_KEY=

# Vídeo sobre jogo: cenas com screenshots oficiais da Steam e trechos dos trailers oficiais,
# misturados com cenas genéricas de games do Pixabay. Trailers podem receber reivindicação do Content ID.
USAR_STEAM=true
USAR_TRAILERS=true

# YouTube: horários de publicação (separados por vírgula) e fuso
HORARIOS=18:00
FUSO=America/Sao_Paulo

# true = publica sozinho, sem passar pela aba Revisão
AUTO_PUBLICAR=false
